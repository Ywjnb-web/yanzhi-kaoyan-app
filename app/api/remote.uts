/* ══════════════════════════════════════════════════════════════
   §7 Feedback（FR-09）与 Compliance（FR-08）
   ══════════════════════════════════════════════════════════════ */

/**
 * 提交反馈。`dataVersion` 必填 —— 没有它就分不清是数据问题还是模型排序问题。
 * 网络失败时建议入本地队列择机重试，不要在反馈按钮上弹错误打断用户。
 */
export async function submitFeedbackRemote(
  planId: string,
  itemId: string,
  kind: string,
  reason: string,
  dataVersion: string,
): Promise<FeedbackCreatedVO> {
  ensureRemote()
  const body: FeedbackBody = {
    planId: planId,
    itemId: itemId,
    kind: kind,
    reason: reason,
    dataVersion: dataVersion,
  }
  const r: HttpResult = await request('POST', EP_FEEDBACK, JSON.stringify(body))
  return unwrap(r) as FeedbackCreatedVO
}

export async function fetchDisclaimer(): Promise<DisclaimerVO> {
  ensureRemote()
  const r: HttpResult = await request('GET', EP_DISCLAIMER, '')
  return unwrap(r) as DisclaimerVO
}

/** 勾选留痕。服务端每次追加一行，不更新 —— 这是合规审计证据。 */
export async function acceptDisclaimer(version: string, devId: string): Promise<boolean> {
  ensureRemote()
  const body = { version: version, deviceId: devId }
  const r: HttpResult = await request('POST', EP_DISCLAIMER_ACCEPT, JSON.stringify(body))
  return r.ok
}

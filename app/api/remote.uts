/* ══════════════════════════════════════════════════════════════
   §5 ExamProfile（FR-01 / FR-02）
   ══════════════════════════════════════════════════════════════ */

function toExamProfileBody(form: ExamForm, declaredTotal: number): ExamProfileBody {
  const provinces: string[] = []
  for (let i = 0; i < form.provinces.length; i++) provinces.push(form.provinces[i])
  const body: ExamProfileBody = {
    provinces: provinces,
    subjectCode: form.subjectCode,
    subjectGroup: form.subjectGroup,
    tier: form.tier,
    major: form.major,
    targetSchool: form.targetSchool,
    isCross: form.isCross,
    politics: form.politics,
    foreign: form.foreign,
    course1: form.course1,
    course2: form.course2,
    declaredTotal: declaredTotal,
  }
  return body
}

/**
 * 表单校验（EX-01）。端上保留本地快速校验，提交前再调这里做二次校验 ——
 * 服务端的 total 是数据库生成列算出来的，比端上更可信。
 */
export async function validateExamRemote(
  form: ExamForm,
  declaredTotal: number = 0,
): Promise<ValidateResultVO> {
  ensureRemote()
  const body = toExamProfileBody(form, declaredTotal)
  const r: HttpResult = await request('POST', EP_EXAM_VALIDATE, JSON.stringify(body))
  return unwrap(r) as ValidateResultVO
}

/** 保存考生档案，返回服务端权威的 ExamInfo（含生成列总分与 EX-02 差异） */
export async function saveExamProfile(
  form: ExamForm,
  declaredTotal: number = 0,
): Promise<ExamInfo> {
  ensureRemote()
  const body = toExamProfileBody(form, declaredTotal)
  const r: HttpResult = await request('PUT', EP_EXAM_PROFILE, JSON.stringify(body))
  return unwrap(r) as ExamInfo
}

export async function fetchExamProfile(): Promise<ExamInfo> {
  ensureRemote()
  const r: HttpResult = await request('GET', EP_EXAM_PROFILE, '')
  return unwrap(r) as ExamInfo
}

export async function savePreference(pref: Preference): Promise<Preference> {
  ensureRemote()
  const body: PreferenceBody = {
    strategies: pref.strategies,
    regions: pref.regions,
    directions: pref.directions,
    careers: pref.careers,
    degreeType: pref.degreeType,
  }
  const r: HttpResult = await request('PUT', EP_EXAM_PREFERENCE, JSON.stringify(body))
  return unwrap(r) as Preference
}

export async function fetchPreference(): Promise<Preference> {
  ensureRemote()
  const r: HttpResult = await request('GET', EP_EXAM_PREFERENCE, '')
  return unwrap(r) as Preference
}

/* ══════════════════════════════════════════════════════════════
   §6 ProgramCatalog（FR-03）
   ══════════════════════════════════════════════════════════════ */

export async function fetchChips(): Promise<ChipListVO> {
  ensureRemote()
  const r: HttpResult = await request('GET', EP_CATALOG_CHIPS, '')
  return unwrap(r) as ChipListVO
}

/**
 * 院校专业检索。对接 `api/index.uts` 的 `searchPrograms()`。
 * 注意 EX-03：`noData=true` 的条目，quota / scoreLine / applyRatio 一律为空串，
 * 页面照旧渲染「暂无数据」，不做任何估算。
 */
export async function fetchPrograms(
  keyword: string = '',
  chip: string = '全部',
  page: number = 1,
  size: number = 20,
): Promise<ProgramPageVO> {
  ensureRemote()
  let path: string = EP_CATALOG_PROGRAMS
  path += '?page=' + page.toString() + '&size=' + size.toString()
  if (keyword.length > 0) path += '&keyword=' + encodeURIComponent(keyword)
  if (chip.length > 0) path += '&chip=' + encodeURIComponent(chip)
  const r: HttpResult = await request('GET', path, '')
  return unwrap(r) as ProgramPageVO
}

/** 按专业代码精确检索 —— S02 科目代码回显与 S06 数据表用 */
export async function fetchProgramsByCode(
  majorCode: string,
  page: number = 1,
  size: number = 20,
): Promise<ProgramPageVO> {
  ensureRemote()
  const path: string =
    EP_CATALOG_PROGRAMS +
    '?page=' +
    page.toString() +
    '&size=' +
    size.toString() +
    '&majorCode=' +
    encodeURIComponent(majorCode)
  const r: HttpResult = await request('GET', path, '')
  return unwrap(r) as ProgramPageVO
}

/** 专业详情（S06 依据详情页数据表） */
export async function fetchProgramDetail(programId: string): Promise<ProgramDetailVO> {
  ensureRemote()
  const r: HttpResult = await request('GET', epProgramDetail(programId), '')
  return unwrap(r) as ProgramDetailVO
}

/**
 * 目标院校检索。对接 `api/index.uts` 的 `suggestSchools()`。
 * **只返回院校库内已收录的院校**；召回为空 = 该院校暂无数据，页面提示 EX-03。
 * 调用点请自行加 300ms 防抖。
 */
export async function fetchSchools(keyword: string = '', limit: number = 20): Promise<SchoolVO[]> {
  ensureRemote()
  let path: string = EP_CATALOG_SCHOOLS + '?limit=' + limit.toString()
  if (keyword.length > 0) path += '&keyword=' + encodeURIComponent(keyword)
  const r: HttpResult = await request('GET', path, '')
  const vo = unwrap(r) as SchoolListVO
  return vo.list
}

/** 精确匹配单个院校；不在库内返回 null（对应 `findSchool()`） */
export async function findSchoolRemote(name: string): Promise<SchoolVO | null> {
  ensureRemote()
  if (name.length === 0) return null
  const path: string =
    EP_CATALOG_SCHOOLS + '?exact=true&limit=1&keyword=' + encodeURIComponent(name)
  const r: HttpResult = await request('GET', path, '')
  const vo = unwrap(r) as SchoolListVO
  if (vo.list.length === 0) return null
  return vo.list[0]
}

/* ══════════════════════════════════════════════════════════════
   §6 PlanGeneration（FR-04 ~ FR-07）
   ══════════════════════════════════════════════════════════════ */

/**
 * 提交生成（FR-04）。返回 taskId，由调用方轮询 `fetchGenerateTask`。
 *
 * 用异步任务而不是同步接口，是因为大模型排序耗时 3~30s 不可控，且 S04
 * 「生成中」页面本身要分三段展示进度 —— 同步接口要么挂死连接，要么端上假进度。
 *
 * @param idemKey 幂等键（UUID）。用户连点两次生成时，服务端返回同一个 taskId
 *                并回 40901，不是报错 —— 调用方照常进入轮询即可。
 */
export async function submitGenerate(
  exam: ExamInfo,
  pref: Preference,
  marks: MarkRecord[],
  planId: string,
  idemKey: string,
): Promise<GenerateSubmitVO> {
  ensureRemote()
  const body: GenerateBody = {
    exam: exam,
    preference: pref,
    marks: marks,
    planId: planId,
  }
  const r: HttpResult = await requestIdempotent(
    'POST',
    EP_PLAN_GENERATE,
    JSON.stringify(body),
    idemKey,
  )
  return unwrap(r) as GenerateSubmitVO
}

/** 查询生成进度。stageLabel / stageDetail 直接来自服务端，端上不再硬编码文案。 */
export async function fetchGenerateTask(taskId: string): Promise<GenerateTaskVO> {
  ensureRemote()
  const r: HttpResult = await request('GET', epGenerateTask(taskId), '')
  return unwrap(r) as GenerateTaskVO
}

/**
 * 便捷封装：提交 + 按固定节奏轮询直到出结果。
 * 页面若需要逐步展示进度（S04），请用上面两个函数自己控节奏。
 */
export async function generatePlanAndWait(
  exam: ExamInfo,
  pref: Preference,
  marks: MarkRecord[],
  planId: string,
  idemKey: string,
): Promise<PlanVO> {
  const submit = await submitGenerate(exam, pref, marks, planId, idemKey)
  let last: GenerateTaskVO | null = null
  for (let i = 0; i < POLL_MAX_TIMES; i++) {
    await sleep(POLL_INTERVAL)
    const task = await fetchGenerateTask(submit.taskId)
    last = task
    if (task.status === 'succeeded') return task.plan as PlanVO
    if (task.status === 'failed' || task.status === 'canceled') {
      throw new ApiError(50001, '方案生成失败，请稍后重试', 200, task.taskId)
    }
  }
  // 超时不再阻断：任务仍在服务端跑，用户可在「我的方案」里看到
  throw new ApiError(50401, '生成时间较长，可稍后在「我的方案」中查看', 200, submit.taskId)
}

function sleep(ms: number): Promise<void> {
  return new Promise<void>((resolve) => {
    setTimeout(() => {
      resolve()
    }, ms)
  })
}

export async function fetchPlans(page: number = 1, size: number = 20): Promise<PlanPageVO> {
  ensureRemote()
  const path: string =
    EP_PLAN_LIST + '?page=' + page.toString() + '&size=' + size.toString()
  const r: HttpResult = await request('GET', path, '')
  return unwrap(r) as PlanPageVO
}

export async function fetchPlanDetail(planId: string): Promise<PlanVO> {
  ensureRemote()
  const r: HttpResult = await request('GET', epPlanDetail(planId), '')
  return unwrap(r) as PlanVO
}

/** 游客本地方案上云（登录时调用）。端上本地缓存**保留**作为离线兜底。 */
export async function importPlans(
  plans: PlanVO[],
  strategy: string = 'skip_existing',
): Promise<ImportResultVO> {
  ensureRemote()
  const body: ImportBody = { plans: plans, strategy: strategy }
  const r: HttpResult = await request('POST', EP_PLAN_IMPORT, JSON.stringify(body))
  return unwrap(r) as ImportResultVO
}

/** FR-06 设置标记。value ∈ ignore / prefer */
export async function setMarkRemote(
  planId: string,
  programId: string,
  value: string,
): Promise<MarkResultVO> {
  ensureRemote()
  const body: MarkBody = { programId: programId, value: value }
  const r: HttpResult = await request('PUT', epPlanMarks(planId), JSON.stringify(body))
  return unwrap(r) as MarkResultVO
}

/** FR-06 取消标记 */
export async function clearMarkRemote(planId: string, programId: string): Promise<MarkResultVO> {
  ensureRemote()
  const r: HttpResult = await request('DELETE', epPlanMark(planId, programId), '')
  return unwrap(r) as MarkResultVO
}

/** FR-06 调整并重新生成。返回新 taskId，由调用方轮询。 */
export async function regeneratePlan(
  planId: string,
  exam: ExamInfo,
  pref: Preference,
  marks: MarkRecord[],
  idemKey: string,
): Promise<GenerateSubmitVO> {
  ensureRemote()
  const body: GenerateBody = {
    exam: exam,
    preference: pref,
    marks: marks,
    planId: planId,
  }
  const r: HttpResult = await requestIdempotent(
    'POST',
    epPlanRegenerate(planId),
    JSON.stringify(body),
    idemKey,
  )
  return unwrap(r) as GenerateSubmitVO
}


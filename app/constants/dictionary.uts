/** 表单里的快捷填充代码（只放最常报的几个，避免占用过多版面） */
export const QUICK_SUBJECT_CODES: string[] = ['085401', '085404', '085405', '085410', '085412']

/** 代码 → 名称；未收录时返回空串（不臆造名称） */
export function subjectCodeNameOf(code: string): string {
  for (let i = 0; i < SUBJECT_CODE_OPTIONS.length; i++) {
    if (SUBJECT_CODE_OPTIONS[i].code === code) {
      return SUBJECT_CODE_OPTIONS[i].name
    }
  }
  return ''
}


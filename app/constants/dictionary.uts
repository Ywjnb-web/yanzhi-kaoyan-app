/* ── 报考科目代码（FR-01） ─────────────────────────────────── */

export interface SubjectCodeOption {
  code: string
  name: string
}

/**
 * 专业代码字典，取自全国硕士研究生招生专业目录中的常见类别：
 *   08 工学 —— 0854 电子信息（专硕）下设 085401~085412 等领域；
 *   0812 计算机科学与技术 / 0810 信息与通信工程 / 0835 软件工程 /
 *   0839 网络空间安全 为学硕一级学科。
 */
export const SUBJECT_CODE_OPTIONS: SubjectCodeOption[] = [
  { code: '085401', name: '新一代电子信息技术（专硕）' },
  { code: '085402', name: '通信工程（专硕）' },

/* ── 报考区域与意向省份（FR-01） ───────────────────────────── */

/**
 * 考研 A 区 / B 区。
 * B 区 10 个省级行政区：内蒙古、广西、海南、贵州、云南、西藏、甘肃、青海、宁夏、新疆；
 * A 区为其余 21 个。
 */
export const B_REGION_PROVINCES: string[] = [
  '内蒙古',
  '广西',
  '海南',
  '贵州',
  '云南',
  '西藏',
  '甘肃',
  '青海',
  '宁夏',
  '新疆',
]

export const A_REGION_PROVINCES: string[] = [
  '北京',
  '天津',
  '河北',
  '山西',
  '辽宁',
  '吉林',
  '黑龙江',
  '上海',
  '江苏',
  '浙江',
  '安徽',
  '福建',
  '江西',
  '山东',
  '河南',
  '湖北',
  '湖南',
  '广东',
  '重庆',
  '四川',
  '陕西',
]

export const EXAM_REGIONS: string[] = ['A 区', 'B 区']

/** 某个区域包含的省份 —— 供选择面板的滚动列表渲染 */
export function provincesOfRegion(region: string): string[] {
  return region === 'B 区' ? B_REGION_PROVINCES : A_REGION_PROVINCES
}

/** 单个省份归属的区域；空串返回空串（不臆测） */
export function regionOfProvince(province: string): string {
  if (province.length === 0) return ''
  for (let i = 0; i < B_REGION_PROVINCES.length; i++) {
    if (B_REGION_PROVINCES[i] === province) {
      return 'B 区'
    }
  }
  return 'A 区'
}

/** 多个意向省份 → 区域标签；跨区时如实标注「A / B 区」 */
export function regionLabelOfProvinces(provinces: string[]): string {
  let hasA = false
  let hasB = false
  for (let i = 0; i < provinces.length; i++) {
    const p = provinces[i]
    if (p.length === 0) continue
    if (regionOfProvince(p) === 'B 区') {
      hasB = true
    } else {
      hasA = true
    }
  }
  if (hasA && hasB) return 'A / B 区'
  if (hasB) return 'B 区'
  if (hasA) return 'A 区'
  return ''
}


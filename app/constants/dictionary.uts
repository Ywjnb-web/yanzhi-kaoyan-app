  { code: '085405', name: '软件工程（专硕）' },
  { code: '085406', name: '控制工程（专硕）' },
  { code: '085410', name: '人工智能（专硕）' },
  { code: '085411', name: '大数据技术与工程（专硕）' },
  { code: '085412', name: '网络与信息安全（专硕）' },
  { code: '081200', name: '计算机科学与技术（学硕）' },
  { code: '081000', name: '信息与通信工程（学硕）' },

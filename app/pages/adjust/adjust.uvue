<template>
  <view class="w-full flex flex-col bg-white">
    <c-nav-bar lead="back" title="调整方案" @lead="back" />

    <view class="w-full flex flex-col px-5 pb-10">
      <text class="w-full text-note text-ink2 mt-1">标记后重新生成，已标记的偏好将保留（FR-06）</text>

      <!-- 待调整项 -->
      <view class="w-full flex flex-col mt-4">
        <view
          v-for="(it, i) in items"
          :key="it.id"
          class="w-full flex flex-col p-3.5 rounded-btn border border-solid border-line2 bg-white"
          :class="i === 0 ? '' : 'mt-3'"
        >
          <view class="w-full flex flex-row items-center justify-between">
            <text class="flex-1 min-w-0 truncate text-sub font-semibold text-ink"
              >{{ it.university }} · {{ it.major }}</text
            >
            <text class="text-cap font-medium text-ink2 ml-2">{{ it.tierName }}</text>
          </view>

          <view class="w-full flex flex-row flex-wrap mt-2.5">
            <view class="mr-2">
              <c-chip
                label="不考虑"
                size="sm"
                :selected="markOf(it.programId) === 'ignore'"
                @press="toggle(it.programId, 'ignore')"
              />
            </view>
            <view class="mr-2">
              <c-chip
                label="优先考虑"
                size="sm"
                :selected="markOf(it.programId) === 'prefer'"
                @press="toggle(it.programId, 'prefer')"
              />
            </view>
          </view>
        </view>
      </view>

      <view v-if="items.length === 0" class="w-full mt-4">
        <c-empty title="还没有可调整的推荐项" desc="请先生成一份择校方案。" />
      </view>

      <!-- 标记汇总 -->
      <view class="w-full mt-4">
        <c-card variant="soft" pad="sm">
          <text class="w-full text-body font-medium text-ink">{{ summaryText }}</text>
        </c-card>
      </view>

      <!-- 操作 -->
      <view class="w-full mt-5">
        <c-btn label="重新生成方案（保留标记）" variant="primary" size="lg" @press="regenerate" />
      </view>
      <view class="w-full mt-2.5">
        <c-btn label="清空所有标记" variant="ghost" size="md" @press="clear" />
      </view>
    </view>
  </view>
</template>

<script setup lang="uts">
/**
 * S07 调整与重新生成　（FR-06）
 *
 * 「不考虑」的项不会静默消失，而是保留在列表里可撤销 —— 考生改主意是常态，
 * 静默移除会让用户以为自己的操作丢了。
 */
import { computed } from 'vue'
import type { RecommendItem } from '../../types/models.uts'
import {
  clearMarks,
  countMark,
  currentPlan,
  markOf,
  setMark,
  regenBackToPlan,
} from '../../store/app.uts'
import { goBack } from '../../utils/nav.uts'

const items = computed<RecommendItem[]>((): RecommendItem[] => {
  const plan = currentPlan.value
  if (plan == null) return []
  const out: RecommendItem[] = []
  for (let g = 0; g < plan.groups.length; g++) {
    const grp = plan.groups[g]
    for (let i = 0; i < grp.items.length; i++) {
      out.push(grp.items[i])
    }
  }
  return out
})

const summaryText = computed<string>((): string => {
  const ignore = countMark('ignore')
  const prefer = countMark('prefer')
  const total = items.value.length
  const none = total - ignore - prefer
  return (
    '已标记：不考虑 ' +
    ignore.toString() +
    ' 所 · 优先考虑 ' +
    prefer.toString() +
    ' 所 · 未标记 ' +
    none.toString() +
    ' 所'
  )
})

function toggle(programId: string, value: string) {
  setMark(programId, value)
}

function clear() {
  clearMarks()
  uni.showToast({ title: '已清空标记', icon: 'none' })
}

function regenerate() {
  // 标记本次生成源自「调整方案」：S04 完成后改为 navigateBack，
  // 复用栈里已有的 S05，避免方案页在栈中重复、按返回像是没反应。
  regenBackToPlan.value = true
  uni.redirectTo({ url: '/pages/generating/generating' })
}

function back() {
  goBack('/pages/plan/plan')
}
</script>

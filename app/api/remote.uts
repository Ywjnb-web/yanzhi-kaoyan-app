/**
 * 异步接口层（后端预留）
 *
 * ══ 定位 ══
 * 本文件是**页面接入真后端时唯一需要改调用的地方**。
 * 每个函数对应 `deliverables/backend/API-契约-研志-V1.0.md` 里的一个接口，
 * 返回类型与 `types/models.uts` 的领域模型对齐 —— 后端就位后页面不会拿到
 * 陌生结构，只是从「同步返回」变成「await 返回」。
 *
 * ══ 与 api/index.uts 的关系 ══
 *   · `api/index.uts`  → 同步实现，本地假数据 + 本地缓存。**离线降级也靠它。**
 *   · `api/remote.uts` → 异步实现，真实后端。
 * 两者并存，不是替换关系：弱网/断网时页面回落到同步实现，交互仍然可用。
 *
 * ══ 迁移顺序建议 ══
 *   检索页 → 生成链路 → 我的方案 → 反馈
 * 从只读的开始换，写链路留到最后，避免中途出现半同步半异步的难查问题。
 */
import type {
  ExamForm,
  ExamInfo,
  Preference,
  PlanVO,
  MarkRecord,
  SearchItem,
  YearRow,
} from '../types/models.uts'
import type { HttpResult, FieldError } from './http.uts'
import { USE_MOCK, POLL_INTERVAL, POLL_MAX_TIMES } from './config.uts'
import { request, requestIdempotent, unwrap, ApiError } from './http.uts'
import {
  EP_AUTH_LOGIN,
  EP_AUTH_REFRESH,
  EP_AUTH_LOGOUT,
  EP_CANDIDATE_ME,
  EP_CANDIDATE_DELETE_DATA,
  EP_CANDIDATE_EXPORT,
  EP_META_DICTIONARIES,
  EP_META_DATA_VERSION,
  EP_EXAM_PROFILE,
  EP_EXAM_VALIDATE,
  EP_EXAM_PREFERENCE,
  EP_CATALOG_CHIPS,
  EP_CATALOG_PROGRAMS,
  EP_CATALOG_SCHOOLS,
  EP_PLAN_GENERATE,
  EP_PLAN_LIST,
  EP_PLAN_IMPORT,
  EP_FEEDBACK,
  EP_DISCLAIMER,
  EP_DISCLAIMER_ACCEPT,
  epProgramDetail,
  epGenerateTask,
  epPlanDetail,
  epPlanMarks,
  epPlanMark,
  epPlanRegenerate,
  epPlanExport,
  epPlanExportResult,
} from './endpoints.uts'

/* ══════════════════════════════════════════════════════════════
   守卫：Mock 模式下调用会得到一句明确的话，而不是一个莫名超时
   ══════════════════════════════════════════════════════════════ */

function ensureRemote(): void {
  if (USE_MOCK) {
    throw new ApiError(
      -2,
      '当前是本地 Mock 模式，请先把 api/config.uts 的 USE_MOCK 置为 false',
      0,
      '',
    )
  }
}

/* ══════════════════════════════════════════════════════════════
   响应模型（契约 §3 ~ §7）
   ══════════════════════════════════════════════════════════════ */

export interface CandidateVO {
  id: string
  nickname: string
  avatarUrl: string
  mobileMasked: string
}

export interface MergeResultVO {
  plans: number
  examProfile: boolean
}

export interface LoginResultVO {
  accessToken: string
  refreshToken: string
  expiresIn: number
  candidate: CandidateVO
  merged: MergeResultVO
}

export interface DataVersionVO {
  dataVersion: string
  publishedAt: string
  /** demo = 演示数值；official = 院校官方发布 */
  dataNature: string
  sourceNote: string
  notice: string
}

/** 字典包。provinces 以「A 区 / B 区」为键，属动态键结构，故保持宽松类型 */
export interface DictionaryBundleVO {
  version: string
  provinces: any
  subjectGroups: any
  subjectCodes: any
  majors: string[]
  tiers: string[]
  degreeTypes: string[]
  strategies: string[]
}

export interface ComputedTotalVO {
  total: number
}

export interface ValidateResultVO {
  valid: boolean
  errors: FieldError[]
  computed: ComputedTotalVO
}

/** 院校选项（对应 FR-01 的目标院校检索） */
export interface SchoolVO {
  university: string
  province: string
  region: string
  level: string
}

export interface ChipListVO {
  chips: string[]
  total: number
}

export interface PageVO {
  page: number
  size: number
  total: number
  hasNext: boolean
}

export interface ProgramPageVO extends PageVO {

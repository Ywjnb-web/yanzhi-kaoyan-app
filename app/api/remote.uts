}

export interface SchoolListVO {
  list: SchoolVO[]
}

export interface GenerateSubmitVO {
  taskId: string
  status: string
  estimatedSeconds: number
}

export interface GenerateTaskVO {
  taskId: string
  /** pending / running / succeeded / failed / canceled */
  status: string
  stageNo: number
  stageLabel: string
  stageDetail: string
  percent: number
  /** 成功后才有值，否则为 null */
  plan: any
  error: any
  /** true = 大模型不可用，已降级为纯规则方案，前端必须标注 */
  degraded: boolean
}

export interface PlanSummaryVO {
  id: string
  name: string

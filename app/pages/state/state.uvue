<template>
  <view class="w-full flex flex-col bg-white">
    <c-nav-bar lead="back" title="异常与边界态" @lead="back" />

    <view class="w-full flex flex-col px-5 pb-10">
      <text class="w-full text-note text-ink2 mt-1"
        >覆盖 PRD 第十二章 EX-01 ~ EX-10 与附录 A.5 异常降级策略</text
      >

      <view class="w-full flex flex-col mt-4">
        <view
          v-for="(ex, i) in exceptions"
          :key="ex.code"
          class="w-full flex flex-col p-3 rounded-btn border border-solid border-line2 bg-white"
          :class="i === 0 ? '' : 'mt-2.5'"
        >
          <text class="w-full text-note font-semibold text-ink">{{ ex.code }} {{ ex.title }}</text>
          <text class="w-full text-cap text-ink2 mt-1.5">{{ ex.strategy }}</text>
        </view>
      </view>

      <text class="w-full text-cap text-ink3 mt-4">{{ others }}</text>

      <view class="w-full mt-5">
        <c-btn label="查看院校检索的缺失数据态" variant="secondary" size="lg" @press="toSearch" />
      </view>
    </view>
  </view>
</template>

<script setup lang="uts">
/**
 * 异常与边界态一览
 *
 * 线框图中的 S11 是一张「设计说明书」，本身不是业务流程的一部分。
 * 在真实产品里它的价值有两个：
 *  1) 让评审一眼看到 10 个异常分支都有明确去处，而不是散落在各页；
 *  2) 作为研发的自测清单 —— 每个 code 对应一条可复现的路径。
 */
import { computed } from 'vue'
import type { ExceptionSpec } from '../../types/models.uts'
import { EXCEPTIONS, EXCEPTION_OTHERS } from '../../constants/dictionary.uts'
import { goBack } from '../../utils/nav.uts'

const exceptions = computed<ExceptionSpec[]>((): ExceptionSpec[] => EXCEPTIONS)
const others = computed<string>((): string => EXCEPTION_OTHERS)

function toSearch() {
  uni.reLaunch({ url: '/pages/search/search' })
}

function back() {
  goBack('/pages/mine/mine')
}
</script>

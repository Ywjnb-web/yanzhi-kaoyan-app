<script setup lang="uts">
/**
 * S00 首页 / 启动　（FR-10 游客免登录 · FR-08 免责声明入口）
 *
 * 首页只推一个动作：「开始择校」。报名期节点作为唯一的信息密度补充，
 * 让考生在没有任何输入前就能确认这件事与自己有关。
 */
import { computed } from 'vue'
import { TIMELINE_NODES } from '../../constants/dictionary.uts'
import type { TimelineNode } from '../../constants/dictionary.uts'

const nodes = computed<TimelineNode[]>((): TimelineNode[] => TIMELINE_NODES)

function start() {
  uni.navigateTo({ url: '/pages/exam-info/exam-info' })
}

/* ══════════════════════════════════════════════════════════════
   请求体模型
   ══════════════════════════════════════════════════════════════ */

interface ExamProfileBody {
  provinces: string[]
  subjectCode: string
  subjectGroup: string
  tier: string
  major: string
  targetSchool: string
  isCross: boolean
  politics: string
  foreign: string
  course1: string
  course2: string
  /** 用户手填的总分，用于服务端比对（EX-02）；不填传 0 */
  declaredTotal: number
}

interface GenerateBody {
  exam: ExamInfo
  preference: Preference
  marks: MarkRecord[]
  planId: string
}

interface MarkBody {
  programId: string
  value: string
}

interface PreferenceBody {
  strategies: string[]
  regions: string[]
  directions: string[]
  careers: string[]
  degreeType: string
}

interface FeedbackBody {
  planId: string
  itemId: string
  kind: string
  reason: string
  dataVersion: string
}

interface ImportBody {
  plans: PlanVO[]
  strategy: string
}

interface LoginBody {
  code: string
  deviceId: string
  nickname: string
  avatarUrl: string
}

interface ConfirmBody {
  confirm: string
}

/* ══════════════════════════════════════════════════════════════
   §3 Identity & Access
   ══════════════════════════════════════════════════════════════ */

export async function login(
  code: string,
  devId: string,
  nickname: string = '',
  avatarUrl: string = '',
): Promise<LoginResultVO> {
  ensureRemote()
  const body: LoginBody = {
    code: code,
    deviceId: devId,
    nickname: nickname,
    avatarUrl: avatarUrl,
  }
  const r: HttpResult = await request('POST', EP_AUTH_LOGIN, JSON.stringify(body))
  return unwrap(r) as LoginResultVO
}

export async function refreshSession(refreshTok: string): Promise<LoginResultVO> {
  ensureRemote()
  const r: HttpResult = await request(
    'POST',
    EP_AUTH_REFRESH,
    JSON.stringify({ refreshToken: refreshTok }),
  )
  return unwrap(r) as LoginResultVO
}

export async function logout(): Promise<void> {
  ensureRemote()
  await request('POST', EP_AUTH_LOGOUT, '')
}

export async function fetchCandidateMe(): Promise<CandidateVO> {
  ensureRemote()
  const r: HttpResult = await request('GET', EP_CANDIDATE_ME, '')
  return unwrap(r) as CandidateVO
}

/** FR-10 删除我的数据。必须显式传 confirm，防误触。 */
export async function deleteMyData(): Promise<DeleteDataVO> {
  ensureRemote()
  const body: ConfirmBody = { confirm: 'DELETE_ALL' }
  const r: HttpResult = await request('DELETE', EP_CANDIDATE_DELETE_DATA, JSON.stringify(body))
  return unwrap(r) as DeleteDataVO
}

/** FR-10 数据可携带：返回原始 JSON 文本，由页面自行落盘或复制 */
export async function exportMyData(): Promise<string> {
  ensureRemote()
  const r: HttpResult = await request('GET', EP_CANDIDATE_EXPORT, '')
  return JSON.stringify(unwrap(r))
}

